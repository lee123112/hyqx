# 根服务运行目录
OPERATOR_POOL_ROOT=./work/pool
# 模型根目录：交付机权重挂载到包内 models/ 时留空即可；
# 开发验证机权重集中在 G:\HYQX\算子\model，可设置 MODEL_ROOT 指向该目录。
MODEL_ROOT=
# 容器内根服务端口（Compose 对外映射为 17006）
PORT=6291

# 回译增强(20)/跨语言合成(23) 默认调用硅基流动 Qwen3.5-9B。
# 只填 Key 即可；算子配置里已内置 https://api.siliconflow.cn/v1/chat/completions。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
# 旧版本地模型服务覆盖项，保持为空（正式版默认使用包内 models/ 本地权重 + 上述 API）。
MODEL_SERVICE_LABSE_URL=
MODEL_SERVICE_XLMR_URL=
MODEL_SERVICE_BGE_M3_URL=
MODEL_SERVICE_QWEN_URL=
MODEL_SERVICE_DOMAIN_URL=
MODEL_SERVICE_BACK_TRANSLATION_URL=
MODEL_SERVICE_SYNTACTIC_URL=
MODEL_SERVICE_CROSS_LINGUAL_URL=
MODEL_SERVICE_TIMEOUT_SECONDS=120
# 离线加载（true 时禁止模型加载时的联网回退；本包模型均已本地化）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# MTY transfer packaging and internal-network object-store mount
OBJECT_STORE_DIR=./work/pool/object_store
