# 跨模态算子包 · 运行环境变量示例
# 复制为 .env 或直接 export（上层 inference.py 与各算子 app.py / inference.py 启动时读取）
#
# 输出根目录：所有算子共用同一挂载卷，便于工程侧按 uniqueId 取产物
OUTPUT_DIR=/data/output

# 权重根目录（可选覆盖）：v1.0 正式版默认由各算子加载自身 <算子目录>/weight/，无需设置。
# 只有需要外挂统一模型盘时才设置，例如把外部模型目录挂到 /models：
# MODEL_ROOT=/models

# ---- 模型调用方式（重要，不要改）----
# 26 个算子的模型全部是「算子内封装的本地权重」：CLIP-ViT/B-32（#12/#14/#16/#18/#20）、
# whisper-base（#08）、YOLOv8n（#17 必需、#12 可选）随各算子目录 <算子目录>/weight/ 一起交付，
# 运行期只从本地读取（local_files_only=True），不联网下载，也不调用任何远程模型 API / 模型网关。
# 因此本文件【没有】MODEL_GATEWAY_BASE_URL / MODEL_APP_ID / MODEL_APP_KEY / MODEL_PATH 等网关变量，
# 部署时也不需要配置任何模型 Key。平台统一模型网关的 APPID/APPKEY（如 audioasr）与 PATH 映射
# （/qwen3-vl-8b-instruct、/chinese-clip-vit-huge-patch14、/Qwen3-ASR-0.6B … 共 17 项）
# 与本包无关：本包 0 处引用，误注入反而会被 verify_service.py 判为配置错误。
# 强制离线开关（HF_HUB_OFFLINE / TRANSFORMERS_OFFLINE / YOLO_OFFLINE=1）
# 已写在 docker-compose.yml 的 environment 里，运行期不会联网下载权重。权重完整性校验：在包根执行
#   sha256sum -c SHA256SUMS.txt        （或 python -X utf8 -B inference.py --preflight）
#
# 上层池化入口（inference.py）
PORT=8100                     # 对外唯一端口
POOL_AUTOSTART=0              # 1=启动即拉起全部 26 个算子进程；0=首次调用按需拉起
POOL_ONLY=                    # 逗号分隔的编号，如 12,13（只暴露部分算子，裁剪镜像用）
POOL_STARTUP_TIMEOUT=60       # 单个算子进程就绪等待秒数

# 上传 / 解压 / 文件数 / 阶段末响应 限额（字节）
# 注意：docker-compose.yml 的 environment 里已写死更大的交付值（2 GiB / 4 GiB / 2000 / 1 GiB），
#       容器部署时以 compose 为准，本文件的 MAX_* 不生效；这里仅用于不经 compose 的单进程/本地运行。
MAX_UPLOAD_BYTES=268435456
MAX_UNPACKED_BYTES=536870912
MAX_UPLOAD_FILES=1000
MAX_RESPONSE_BYTES=67108864

# 任务级最终输出（《输出格式.md》§3：阶段末算子把本阶段血缘增量写入任务级输出）
TASK_OUTPUT_ENABLED=1             # 0=关闭阶段末写入（仅调试用）；默认 1
# TASK_OUTPUT_ROOT=/data/output   # 任务级输出根；不设时用 OUTPUT_DIR
# TASK_OUTPUT_SCAN_ROOT=          # 阶段束扫描根；不设时用输出根（同卷部署无需设置）
# TASK_OUTPUT_LOCK_TIMEOUT=600    # 输出目录文件锁等待秒数（防并发发布互踩）

# 时区（血缘时间戳）
TZ=Asia/Shanghai

# ---- Docker Compose / 镜像构建（仅构建/部署机使用，容器内运行不需要）----
# 包内已提供 .env；需要重新初始化配置时可复制本示例，或直接用环境变量覆盖。
# HOST_PORT=17059                          # compose 宿主机端口（默认 17059）
# OUTPUT_HOST_DIR=/data/webapp/idg/数据工程产线算子/operator-output/opcrossmodalpool
#   默认值沿用本产线历史路径；若服务器按 deployment-kit 的父目录放置，改为：
#   OUTPUT_HOST_DIR=/data/webapp/idg/新数据工程产线算子/operator-output/opcrossmodalpool
# PYTHON_IMAGE=python:3.11-slim            # 国内拉不动就换加速地址，如 docker.m.daocloud.io/library/python:3.11-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple   # 默认清华 TUNA，内网源按需替换
# PIP_TRUSTED_HOST=                        # 私有 HTTP PyPI 时才填
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn  # 默认清华 TUNA Debian 镜像；填 off 用基础镜像自带源
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu     # 可选：装 CPU 版 torch（镜像小约 2 GB、不含 CUDA 库）
# TORCH_VERSION=2.3.1                       # 配合 TORCH_INDEX_URL 使用
# TORCHVISION_VERSION=0.18.1
# OMP_NUM_THREADS=8                        # 可选：CPU 推理线程数，与容器 CPU limit 对齐
# EXPECT_CPU=1                             # 纯 CPU 交付：verify_service.py 断言无 CUDA、设备解析为 cpu
