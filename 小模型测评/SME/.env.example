# Docker Compose reads .env in this directory. No developer machine paths.
SME_HTTP_PORT=17024
SME_API_KEY=
SME_CORS_ORIGINS=http://localhost:17024,http://127.0.0.1:17024
SME_MAX_UPLOAD_MB=200
SME_MAX_WORKERS=1
SME_TEXT_TIMEOUT_SECONDS=600
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
# Build-time dependency indexes; change these for an internal package mirror.
PIP_INDEX_URL=https://pypi.org/simple
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
